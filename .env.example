# --- Admin panel login -------------------------------------------------------
# הסיסמה לכניסה ל-/admin. חובה בפרודקשן.
ADMIN_PASSWORD=

# מפתח לחתימת עוגיית ההתחברות. צרו מחרוזת אקראית: openssl rand -base64 32
AUTH_SECRET=

# --- Storage (Upstash Redis / Vercel KV) -------------------------------------
# מותקן אוטומטית כשמחברים Upstash ב-Vercel Marketplace.
# בלי זה הפרויקט עובד מקומית עם קובץ JSON ב-.data/ (לא מתאים לפרודקשן).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# כתובת הוובהוק להזמנות *לא* נמצאת כאן — מגדירים אותה בלוח הבקרה ב-/admin

# כתובת האתר בפרודקשן (לתגיות OG). ב-Vercel נגזר אוטומטית מ-VERCEL_PROJECT_PRODUCTION_URL
NEXT_PUBLIC_SITE_URL=
